public constant GOLIATH_ID = compiletime(HERO_ID_GEN.next())
// public constant GOLIATH_SPELLS = new LinkedList<int>..add(WATER_ELEMENTAL_ID, AQUA_BLAST_ID, BUBBLE_SHIELD_ID, SEA_AURA_ID, TSUNAMI_ID)
public constant GOLIATH_NAME = "Goliath"
public constant GOLIATH_DESCRIPTION = "Goliath//."

@compiletime function genHero()
  new IntHeroPreset(GOLIATH_ID, UnitIds.taurenchieftain, GOLIATH_NAME)
  ..addProperName("Cronus")
  // ..addHeroAbility(AQUA_BLAST_ID)
  // ..addHeroAbility(SEA_AURA_ID)
  // ..addHeroAbility(BUBBLE_SHIELD_ID)
  // ..addHeroAbility(TSUNAMI_ID)
  // ..addInnateHeroAbility(WATER_ELEMENTAL_ID)
  ..setStartingStrength(30)
  ..setStrengthPerLevel(4)
  ..setStartingAgility(12)
  ..setAgilityPerLevel(1.2)
  ..setStartingIntelligence(10)
  ..setIntelligencePerLevel(1.3)
  ..setAttack1CooldownTime(2.5)
  ..setAttack1DamageNumberofDice(1)
  ..setAttack1DamageSidesperDie(10)
  ..setAttack1Range(128)
  ..buildHero()
